{
  "name": "scRNAseq Normalisation",
  "description": "Normalises single-cell RNA sequencing data.",
  "tags": [
    "omics",
    "sc-RNA-seq",
    "preprocessing"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/scRNAseq_normalize_operator"
  ],
  "properties": [
    {
      "kind": "EnumeratedProperty",
      "name": "normalization.method",
      "defaultValue": "LogNormalize",
      "values": [
        "LogNormalize",
        "CLR",
        "RC"
      ],
      "description": "Method for normalization. LogNormalize: Feature counts for each cell are divided by the total counts for that cell and multiplied by the scale.factor. This is then natural-log transformed using log1p. CLR: Applies a centered log ratio transformation. RC: Relative counts. Feature counts for each cell are divided by the total counts for that cell and multiplied by the scale.factor. No log-transformation is applied."
    },
    {
      "kind": "DoubleProperty",
      "name": "scale.factor",
      "defaultValue": 10000,
      "description": "Sets the scale factor for cell-level normalization."
    }
  ],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "0.0.1",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "Cell ID",
            "type": "",
            "description": "Cell identifiers",
            "ontologyMapping": "observation",
            "crosstabMapping": "column",
            "cardinality": "1..n",
            "factors": []
          },
          {
            "kind": "MetaFactor",
            "name": "Gene ID",
            "type": "",
            "description": "Gene identifiers",
            "ontologyMapping": "variable",
            "crosstabMapping": "row",
            "cardinality": "1..n",
            "factors": []
          }
        ],
        "axis": [
          {
            "kind": "AxisSpec",
            "metaFactors": [
              {
                "kind": "MetaFactor",
                "name": "Count Data",
                "type": "numeric",
                "description": "Count data for each cell",
                "ontologyMapping": "measurement",
                "crosstabMapping": "y",
                "cardinality": "1",
                "factors": []
              }
            ]
          }
        ]
      }
    ]
  }
}